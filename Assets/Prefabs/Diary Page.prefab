  m_Script: {fileID: 11500000, guid: 229af5a8edfa53443af586ec153bdf22, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Interaction.DiaryPage
  body: 'Today is the signing event for my new book, Ten Days.


    The line of
    fans stretches all the way across the square.


    Everyone looks so happy.
    Though I suppose no one is happier than me.


    Once upon a time, no one would
    even give me a second glance. But now, I''ve found the secret to writing bestsellers.


    All
    I have to do is repeat the formula and finish the remaining four books in the
    series. Then I''ll never have to worry about money again.


    The pinnacle
    of a liberal arts graduate''s career!


    After that, I''ll leave this cramped
    little apartment and retire somewhere in the suburbs, where I can finally enjoy
    a quiet life.'
  bodyText: {fileID: 7712826971027322063}
  tts: {fileID: 0}
  llmConfigResourcePath: LLM/llm-config
